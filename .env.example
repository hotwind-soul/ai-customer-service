# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略。
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# 生成方式见《安全配置与迁移说明.md》；必须是 32 字节随机值的 Base64。
AICS_CONFIG_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes

# 只在新库首次启动或替换历史 agent123 时填写；成功启动后从 .env 删除此行。
AICS_BOOTSTRAP_ADMIN_PASSWORD=ReplaceMe8

# 生产环境必填，多个来源用逗号分隔，不要填写星号。
AICS_WS_ALLOWED_ORIGINS=https://your-domain.com

# 企微图文地址卡片缩略图使用；必须是当前系统可公网访问的 HTTPS 根地址。
AICS_PUBLIC_BASE_URL=https://your-domain.com

DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
